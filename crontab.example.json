{
  "app": {
    "service_name": "WinCron",
    "display_name": "WinCron 定时任务服务",
    "description": "Windows Cron 定时任务管理服务，替代系统计划任务",
    "service_user": "",
    "service_password": "",
    "web_enabled": true,
    "web_port": 9090,
    "web_username": "admin",
    "web_password": "CHANGE_ME_BEFORE_USE",
    "log_dir": "logs",
    "log_retention_days": 30,
    "enable_seconds": true,
    "notify_timeout": 10,
    "notify_channels": [
      {
        "name": "ops-wecom",
        "type": "wecom",
        "url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=${ENV:WINCRON_WECOM_KEY}",
        "mentioned_mobile_list": ["@all"]
      },
      {
        "name": "ops-slack",
        "type": "slack",
        "token": "${ENV:WINCRON_SLACK_TOKEN}",
        "receivers": ["#ops-alerts"]
      }
    ]
  },
  "jobs": [
    {
      "id": "example-backup",
      "name": "每日备份（示例）",
      "cron": "0 2 * * *",
      "command": "echo backup",
      "work_dir": "",
      "enabled": false,
      "timeout": 0,
      "max_retry": 0,
      "notify": {
        "on_success": false,
        "on_failure": true,
        "channels": ["ops-wecom"]
      },
      "env": {}
    }
  ]
}
